{
  "name": "mdh",
  "version": "1.8.4",
  "private": true,
  "type": "module",
  "author": "MDH Team",
  "description": "MDH - 大荒界：多智能体协作桌面应用",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:backend": "python3 backend/server.py",
    "dev:electron": "concurrently \"vite --port 8080\" \"wait-on http://localhost:8080 && node electron/esbuild.config.mjs && electron .\"",
    "build": "vite build",
    "build:electron": "vite build && node electron/esbuild.config.mjs",
    "build:shell": "echo 'plugin-shell removed, skipping esbuild'",
    "package": "npm run build:electron && electron-builder --config electron-builder.yml",
    "package:win": "npm run build:electron && electron-builder --win --config electron-builder.yml",
    "package:mac": "npm run build:electron && electron-builder --mac --config electron-builder.yml",
    "package:linux": "npm run build:electron && electron-builder --linux --config electron-builder.yml",
    "preview": "vite preview",
    "start": "npm run build && vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agentscope-ai/chat": "^1.1.65",
    "@agentscope-ai/design": "^1.0.32",
    "@react-three/drei": "^9.120.4",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "antd": "^5.23.0",
    "docx": "^9.7.1",
    "electron-updater": "^6.3.0",
    "postprocessing": "^6.39.1",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.30.4",
    "three": "^0.170.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.0",
    "concurrently": "^9.1.0",
    "electron": "33.4.11",
    "electron-builder": "^25.1.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wait-on": "^8.0.0"
  }
}

{
  "name": "mdh-orchestrator",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "mdh": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "loop": "tsx src/loop/loop.ts",
    "loop:retry": "tsx src/loop/loop.ts --retry-failed",
    "loop:scenario": "tsx src/loop/loop.ts --scenario=",
    "loop:ci": "cd ../loop-engineering && npx tsx src/main.ts ci"
  },
  "dependencies": {
    "glob": "^11.0.0",
    "playwright": "^1.40.0",
    "tsx": "^4.7.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  }
}
